{
  "name": "sql-inlay-hints",
  "displayName": "SQL-Inlay-Hints",
  "description": "Inlay Hints for SQL INSERT INTO Statements in VSCode",
  "publisher": "JUNGHO",
  "license": "Apache-2.0",
  "version": "1.1.6",
  "main": "./out/extension.js",
  "icon": "logo.webp",
  "repository": {
    "type": "git",
    "url": "https://github.com/jungho-dev/sql-inlay-hints.git"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "sql",
    "xml",
    "mapper",
    "mybatis",
    "inlay",
    "hints",
    "inlay-hints",
    "sql-inlay-hints"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:xml"
  ],
  "contributes": {
    "outputChannels": [
      "SQL-Inlay-Hints"
    ],
    "configurationDefaults": {
      "[sql]": {
        "editor.inlayHints.maximumLength": 0,
        "editor.inlayHints.enabled": "on",
        "editor.wordWrapColumn": 200,
        "editor.wordWrap": "wordWrapColumn",
        "editor.inlayHints.fontSize": 10
      },
      "[xml]": {
        "editor.inlayHints.maximumLength": 0,
        "editor.inlayHints.enabled": "on",
        "editor.wordWrapColumn": 200,
        "editor.wordWrap": "wordWrapColumn",
        "editor.inlayHints.fontSize": 10
      }
    },
    "configuration": {
      "title": "SQL-Inlay-Hints",
      "properties": {
        "SQL-Inlay-Hints.enableSql": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Enable inlay hints for SQL files"
        },
        "SQL-Inlay-Hints.enableXml": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Enable inlay hints for XML mapper files"
        },
        "SQL-Inlay-Hints.enableKeywordHighlight": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Enable SQL keyword syntax highlighting for .sql and .xml files"
        },
        "SQL-Inlay-Hints.commentColor": {
          "type": "string",
          "scope": "window",
          "default": "#ffff00",
          "description": "Color for query comments (<!-- --> only)"
        },
        "SQL-Inlay-Hints.stringColor": {
          "type": "string",
          "scope": "window",
          "default": "#f4d4ae",
          "description": "Color for SQL string literals (e.g., 'text')"
        },
        "SQL-Inlay-Hints.numberColor": {
          "type": "string",
          "scope": "window",
          "default": "#00FF00",
          "description": "Color for SQL numeric literals (e.g., 123, 3.14, 1e9)"
        },
        "SQL-Inlay-Hints.logLevel": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        }
      }
    }
  },
  "engines": {
    "vscode": ">=1.118.0",
    "node": ">=21.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "git": "bun run ~/.bootstrap/bootstrap-sync.ts --git",
    "swc": "bun run ~/.bootstrap/bootstrap-sync.ts --swc",
    "sync": "bun run ~/.bootstrap/bootstrap-sync.ts --sync",
    "tools": "bun run ~/.bootstrap/bootstrap-sync.ts --tools"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.33",
    "@swc/helpers": "0.5.21",
    "@types/node": "25.6.0",
    "@types/vscode": "1.118.0",
    "@vscode/vsce": "3.9.1",
    "esbuild": "0.28.0",
    "ts-morph": "28.0.0",
    "ts-prune": "0.10.3",
    "tsc-alias": "1.8.17",
    "typescript": "6.0.3"
  }
}
