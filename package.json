{
  "name": "sql-inlay-hints",
  "displayName": "SQL-Inlay-Hints",
  "description": "Inlay Hints for SQL INSERT INTO Statements in VSCode",
  "publisher": "JUNGHO",
  "license": "Apache-2.0",
  "version": "1.0.9",
  "main": "./out/extension.js",
  "icon": "logo.webp",
  "repository": {
    "type": "git",
    "url": "https://github.com/JUNGHO-GIT/SQL-INLAY-HINTS.git"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "sql",
    "xml",
    "mapper",
    "mybatis",
    "inlay",
    "hints",
    "inlay-hints",
    "sql-inlay-hints"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:xml"
  ],
  "contributes": {
    "outputChannels": [
      "SQL-Inlay-Hints"
    ],
    "configurationDefaults": {
      "[sql]": {
        "editor.inlayHints.maximumLength": 0,
        "editor.inlayHints.enabled": "on",
        "editor.wordWrapColumn": 200,
        "editor.wordWrap": "wordWrapColumn",
        "editor.inlayHints.fontSize": 10
      },
      "[xml]": {
        "editor.inlayHints.maximumLength": 0,
        "editor.inlayHints.enabled": "on",
        "editor.wordWrapColumn": 200,
        "editor.wordWrap": "wordWrapColumn",
        "editor.inlayHints.fontSize": 10
      }
    },
    "configuration": {
      "title": "SQL-Inlay-Hints",
      "properties": {
        "SQL-Inlay-Hints.enableSql": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Enable inlay hints for SQL files"
        },
        "SQL-Inlay-Hints.enableXml": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Enable inlay hints for XML mapper files"
        },
        "SQL-Inlay-Hints.enableKeywordHighlight": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Enable SQL keyword syntax highlighting for .sql and .xml files"
        },
        "SQL-Inlay-Hints.commentColor": {
          "type": "string",
          "scope": "window",
          "default": "#ffff00",
          "description": "Color for query comments (<!-- --> only)"
        },
        "SQL-Inlay-Hints.stringColor": {
          "type": "string",
          "scope": "window",
          "default": "#f4d4ae",
          "description": "Color for SQL string literals (e.g., 'text')"
        },
        "SQL-Inlay-Hints.numberColor": {
          "type": "string",
          "scope": "window",
          "default": "#00FF00",
          "description": "Color for SQL numeric literals (e.g., 123, 3.14, 1e9)"
        },
        "SQL-Inlay-Hints.logLevel": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        }
      }
    }
  },
  "engines": {
    "vscode": ">=1.107.0",
    "node": ">=21.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "sync": "bun .node/mjs/sync.mjs --bun --sync --server",
    "start": "bun .node/mjs/swc.mjs --bun --start --server",
    "build": "bun .node/mjs/swc.mjs --bun --build --server",
    "fix": "bun .node/mjs/fix.mjs --bun --fix",
    "reset": "bun .node/mjs/reset.mjs --bun --reset",
    "vsce": "bun .node/mjs/vsce.mjs --bun --package",
    "git-push-y": "bun .node/mjs/git.mjs --bun --push --y",
    "git-push-n": "bun .node/mjs/git.mjs --bun --push --n"
  },
  "dependencies": {},
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.6.1",
    "@swc/cli": "0.7.9",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/eslint": "9.6.1",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "25.0.3",
    "@types/vscode": "1.107.0",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "@vscode/vsce": "3.7.1",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "eslint-define-config": "2.1.0",
    "eslint-plugin-html": "8.1.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-unicorn": "62.0.0",
    "globals": "17.0.0",
    "ts-morph": "27.0.2",
    "ts-prune": "0.10.3",
    "tsc-alias": "1.8.16",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.51.0"
  }
}
